{
  "name": "japanese-date-format",
  "version": "1.1.8",
  "description": "Convert Date object to Japanese notation",
  "main": "./dist/japanese-date.cjs",
  "module": "./dist/japanese-date.mjs",
  "types": "./dist/japanese-date.d.ts",
  "jsdelivr": "./dist/japanese-date.js",
  "unpkg": "./dist/japanese-date.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/japanese-date.d.mts",
        "default": "./dist/japanese-date.mjs"
      },
      "require": {
        "types": "./dist/japanese-date.d.ts",
        "default": "./dist/japanese-date.cjs"
      },
      "default": "./dist/japanese-date.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "npm run test && npm run lint",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exizlynx/JapaneseDate.git"
  },
  "keywords": [
    "date",
    "japanese",
    "convert"
  ],
  "author": "ExiZ",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/exizlynx/JapaneseDate/issues"
  },
  "homepage": "https://exizlynx.github.io/JapaneseDate/",
  "overrides": {
    "esbuild": "^0.28.1",
    "browserslist": "^4.28.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "babel-jest": "^30.2.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.7.0",
    "jest": "^30.2.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
